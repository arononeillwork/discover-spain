# Discover Spain: Supabase connection.
#
#   cp .env.example .env.local
#
# The values below are the local Supabase defaults printed by `npx supabase status -o env`
# after `npx supabase start`. They are public demo keys that only work against the local
# stack, so they are safe to commit. For a hosted project, use its URL and publishable key
# (Project Settings -> API) in .env.local instead, and never put a secret / service_role key
# in a NEXT_PUBLIC_ variable.

# Supabase API URL used by the browser. NEXT_PUBLIC_ values are inlined at build time,
# so rebuild after changing them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). Row Level Security decides what it can read/write.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Optional, server-only, read at runtime: the Supabase URL the Next.js server should use when it
# differs from the browser's. Example: the app runs in Docker and Supabase on the host:
# SUPABASE_URL=http://host.docker.internal:54321
# SUPABASE_URL=
